# Native systemd unit for gha-docker-controller.
#
# The primary distribution path is native systemd; the controller container
# (root Dockerfile) is the auxiliary path.
#
# Required preparation:
#   1. Place the binary at /usr/local/bin/gha-docker-controller (install the
#      binary built with the direct Go command in the README:
#      CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X ..."
#      -o bin/gha-docker-controller ./cmd/gha-docker-controller).
#   2. Create a dedicated user/group.
#        useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin gha-docker-controller
#   3. Check the group of the Docker socket and add the dedicated user to it
#      (the default Docker install uses the group name docker).
#        usermod -aG docker gha-docker-controller
#   4. Place the config and secret files in /etc/gha-docker-controller/ with
#      ownership/permission readable by the gha-docker-controller user
#      (recommended: user:group = gha-docker-controller:gha-docker-controller, 0600).
#      The App private key is referenced by config github.app.privateKeyFile.
#   5. Only with PAT auth, write one line GITHUB_TOKEN=<PAT> to the 0600
#      environment file /etc/gha-docker-controller/environment (not needed
#      with GitHub App auth). The environment file path itself is not a
#      secret.
#
# Example: environment file for PAT auth
#   GITHUB_TOKEN=github_pat_xxx
#
# The controller holds control privileges over the Docker host, but these
# are not inherited by runner containers. There is no setup that passes the
# Docker socket or this unit's config/secret to a runner.

[Unit]
Description=GitHub Actions runner scale set controller (gha-docker-controller)
# Start only after the Docker daemon and the network are available.
Wants=network-online.target
After=network-online.target docker.service

[Service]
# Run serve in the foreground without daemonizing. The cli shuts down
# gracefully on SIGTERM.
Type=simple

# Dedicated unprivileged user/group. Never run as root.
User=gha-docker-controller
Group=gha-docker-controller
# The group needed to connect to the Docker socket (host default
# root:docker 0660). Adjust it when the socket group is not docker.
SupplementaryGroups=docker

# State the default paths of serve and config explicitly. The App private
# key path is given in the config and lives under /etc/gha-docker-controller.
ExecStart=/usr/local/bin/gha-docker-controller serve --config /etc/gha-docker-controller/config.yaml

# Only with PAT auth, read GITHUB_TOKEN from the 0600 environment file
# /etc/gha-docker-controller/environment. The "-" prefix keeps startup from
# failing when the file is absent (the GitHub App auth setup). The
# environment file path itself is not a secret.
EnvironmentFile=-/etc/gha-docker-controller/environment

# Restart on crash. Even an immediate-start failure such as a config error
# is retried at the RestartSec interval and can be seen in the journal.
Restart=on-failure
RestartSec=5s

# Graceful shutdown starts on SIGTERM. Every shutdown phase has its own
# timeout; with the defaults the maximum stop time is provisioning timeout
# (5 minutes, the upper bound for an in-flight handler of the official
# listener) + shutdown grace (2 minutes, runner cleanup) + 5s (health) + 30s
# (session) = 455s. TimeoutStopSec=480 covers these 455s; on exceeding it,
# systemd SIGKILLs; Recover on the next startup collects the leftover
# containers.
KillSignal=SIGTERM
TimeoutStopSec=480

# --- hardening ---
# The whole tree is read-only. Config and secrets are read-only from /etc.
# Connecting to the Docker socket does not change the filesystem, so it is
# unaffected (socket access is not broken).
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# The daemon only uses Docker (AF_UNIX) and the GitHub API
# (AF_INET/AF_INET6) sockets; all other address families are forbidden.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# A daemon running as an unprivileged user needs no capability; the
# bounding set is emptied.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
